# Browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only values (set in Vercel; never prefix with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-haiku-4-5
TEACHER_DASHBOARD_PASSWORD=choose-a-long-password
SCHOOL_GOOGLE_DOMAIN=example.edu.sg

# Optional pricing overrides for dashboard estimates
ANTHROPIC_INPUT_USD_PER_MILLION=1
ANTHROPIC_OUTPUT_USD_PER_MILLION=5
